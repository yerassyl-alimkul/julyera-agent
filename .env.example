# Скопируй этот файл в .env и заполни своими значениями.
# .env НИКОГДА не коммить в git — добавь его в .gitignore.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key
GROQ_API_KEY=your-groq-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Только для продакшена (Render и т.п.) — URL, по которому будет доступен
# задеплоенный backend. При старте приложение само зарегистрирует webhook.
# Локально НЕ задавай эту переменную — вместо неё используй bot.py (polling).
WEBHOOK_BASE_URL=

# Секрет для эндпоинта /internal/reminders/run (вызывается GitHub Actions по расписанию).
REMINDERS_SECRET=

# Google Calendar — OAuth-данные из Google Cloud Console (см. инструкцию).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://julyera-agent.onrender.com/google/callback

# Секрет для подписи state при подключении Google Calendar (случайная строка от 32 символов).
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_STATE_SECRET=
